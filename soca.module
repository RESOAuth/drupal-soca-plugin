<?php

/** @file SOCA native account and login integration. */

require_once __DIR__ . '/bootstrap.php';

function soca_form_user_login_form_alter(array &$form, \Drupal\Core\Form\FormStateInterface $form_state): void {
    $form['soca'] = ['#type' => 'link', '#title' => t('Sign in with SOCA'),
        '#url' => \Drupal\Core\Url::fromRoute('soca.login'), '#weight' => 100];
}

function soca_user_delete(\Drupal\user\UserInterface $account): void {
    \Drupal::database()->delete('soca_links')->condition('uid', $account->id())->execute();
}
